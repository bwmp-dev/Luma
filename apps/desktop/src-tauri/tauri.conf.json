{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma",
  "version": "0.18.0",
  "identifier": "dev.bwmp.luma",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm apple:icon && pnpm --dir ../.. shared:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luma",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src 'self' https://collab.luma.bwmp.dev wss://collab.luma.bwmp.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "iOS": {
      "developmentTeam": "828MX392ZN"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.macos.plist"
    },
    "resources": {
      "icons/Assets.car": "Assets.car"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/star.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "luma"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "luma"
        ]
      }
    },
    "updater": {
      "active": true,
      "pubkey": "PLACEHOLDER_CI_INJECTS_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/bwmp-dev/Luma/releases/latest/download/latest.json"
      ]
    }
  }
}
