# SQLx migration checksums hash raw bytes; enforce stable bytes on every platform.
apps/desktop/src-tauri/migrations/*.sql text eol=lf
apps/desktop/src-tauri/gen/apple/ci_scripts/*.sh text eol=lf
# `sh` chokes on CRLF in a script it is asked to run ("set: Illegal option -").
scripts/luma-hook text eol=lf
# codesign's entitlements parser (AMFIUnserializeXML) rejects CRLF: "syntax error near line 1".
*.plist text eol=lf
*.entitlements text eol=lf
*.xcprivacy text eol=lf
# Cryptographic test vectors produced by puttygen and ssh-keygen. They are
# compared byte for byte, so a CRLF checkout on Windows would rewrite the
# very thing under test.
apps/desktop/src-tauri/tests/fixtures/ppk/* text eol=lf
